{
  "name": "@starscout/tray",
  "private": true,
  "version": "0.1.0",
  "description": "StarScout Windows タスクトレイ常駐アプリ",
  "author": "hidep-hub",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.starscout.tray",
    "productName": "StarScout",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico"
    }
  }
}
